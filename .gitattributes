# Store and check out all text files with LF line endings on every platform.
* text=auto eol=lf

# Windows command scripts require CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never convert line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
*.scn binary
